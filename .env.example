# Required for real Gemini story generation
GEMINI_API_KEY=

# Required for real remote image generation through Hugging Face Inference Providers
HF_TOKEN=
HF_PROVIDER=auto

# Gemini models. These can be changed without editing Python files.
GEMINI_OUTLINE_MODEL=gemini-2.5-flash
GEMINI_STORY_MODEL=gemini-2.5-pro

# Current Hugging Face diffusion example. The image provider/model are configurable.
IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
IMAGE_WIDTH=768
IMAGE_HEIGHT=768
IMAGE_STEPS=4
IMAGE_TIMEOUT=180

# Keeps the full application testable without API keys.
ALLOW_DEMO_MODE=true
